{
  "$schema": "https://oxc-project.github.io/oxc/schema/linter.json",
  // Formatting is intentionally outside oxlint; no formatter is configured.
  // The restriction rule below protects dependency direction. Shared gameplay
  // vocabulary is imported from its owning package rather than mirrored here.
  // Time-dependent state uses mc-kernel's ClockPort or Effect's Clock. The
  // boundary is kept visible in types and tests because the linter cannot
  // express every time-source policy reliably.
  "env": {
    "es2022": true,
    "node": true
  },
  "settings": {
    "typescript": {
      "version": "6.0"
    }
  },
  "plugins": [],
  "categories": {
    "correctness": "warn",
    "suspicious": "warn",
    "perf": "warn",
    "style": "off",
    "restriction": "warn"
  },
  "rules": {
    // TypeScript-specific rules
    // Prefer `type` over `interface` for pure data types (Schema.Struct pattern).
    "@typescript-eslint/consistent-type-definitions": ["warn", "type"],
    "@typescript-eslint/no-explicit-any": "off",
    "@typescript-eslint/no-unused-vars": "warn",
    "@typescript-eslint/no-floating-promises": "warn",
    "@typescript-eslint/no-misused-new": "warn",
    "@typescript-eslint/no-unnecessary-type-assertion": "warn",
    "@typescript-eslint/no-var-requires": "warn",
    "@typescript-eslint/prefer-enum-initializers": "warn",
    "@typescript-eslint/prefer-for-of": "warn",
    "@typescript-eslint/prefer-literal-enum-member": "warn",

    // Correctness
    "no-array-constructor": "warn",
    "no-empty": "warn",
    "no-eq-null": "warn",
    "no-extra-boolean-cast": "warn",
    "no-fallthrough": "warn",
    "no-irregular-whitespace": "warn",
    "no-self-compare": "warn",
    "no-throw-literal": "warn",
    "no-unreachable": "warn",
    "use-isnan": "warn",
    "valid-typeof": "warn",

    // Suspicious
    "no-console": "warn",
    "no-debugger": "warn",
    "no-empty-function": "warn",
    "no-empty-pattern": "warn",
    // `_tag` is the Effect-TS tagged-union discriminator (Schema.TaggedClass /
    // Data.TaggedEnum); this is a framework convention, not a naming choice,
    // so it is exempted from the blanket `suspicious` category's
    // no-underscore-dangle rule. Matches @nerima-games/mc-save's
    // `.oxlintrc.json` (same exemption, same rationale).
    "no-underscore-dangle": ["warn", { "allow": ["_tag"] }],
    "no-eval": "error",
    "no-implied-eval": "error",
    "no-redeclare": "warn",
    "no-shadow": "warn",
    "no-unreachable-loop": "warn",
    "no-unused-private-class-members": "warn",

    // Performance
    "no-await-in-loop": "warn",
    "no-loop-func": "warn",
    "no-promise-executor-return": "warn",
    "no-sync": "warn",

    // Style
    // Formatting remains outside the linter; these correctness rules are
    // enabled explicitly while the style category stays off.
    "no-array-method-this-argument": "warn",
    // PERFORMANCE / CORRECTNESS EXCEPTION — src/domain/explosion.ts's
    // `hashUnit` is a deterministic uint32-wrapping hash (xorshift-style
    // finalizer): `^`, `Math.imul`, `>>>`, `| 0`. Those are not a
    // micro-optimisation, they are the specification of the function.
    // Rewriting them with arithmetic operators would change the values the
    // hash produces, and the seed -> value mapping is a frozen contract.
    // Matches @nerima-games/mc-noise's `.oxlintrc.json` (same exception,
    // same rationale, for its seed-hash and permutation-table code).
    "no-bitwise": "off",

    // Restriction
    "default-case": "warn",
    "default-case-last": "warn",
    "no-empty-character-class": "warn",
    // This documents restricted globals; time-source policy is enforced at
    // typed service boundaries and by tests.
    "no-restricted-globals": ["warn", "name", "open", "close", "event"],
    "no-restricted-imports": [
      "error",
      {
        "paths": [
          {
            "name": "effect",
            "message": "Please use named imports from 'effect' package",
            "importNames": ["default"]
          }
        ],
        // mc-sim is Tier2 (DEPENDENCY_POLICY.md §1) and may depend only on
        // mc-physics, mc-save, mc-worldgen, and the universally-importable
        // mc-kernel. This covers every other @nerima-games/* package in the
        // org, including the Tier1 siblings (mc-noise, mc-meshing, mc-audio),
        // the Tier2 siblings (mc-render, mc-playground-kit), and all of
        // Tier3/Tier4 — Tier2 must not depend laterally or upward.
        //
        // `group` is a glob with `!` negation, which keeps the allowed package
        // set explicit and reviewable.
        "patterns": [
          {
            "group": [
              "@nerima-games/*",
              "!@nerima-games/mc-kernel",
              "!@nerima-games/mc-physics",
              "!@nerima-games/mc-save",
              "!@nerima-games/mc-worldgen"
            ],
            "message": "mc-sim (Tier2, DEPENDENCY_POLICY.md) may depend only on mc-physics, mc-save, mc-worldgen, and mc-kernel. Propose a graph change (DEPENDENCY_POLICY.md §6) before adding this import."
          }
        ]
      }
    ],
    "prefer-template": "warn",

    // Disabled rules (conflict with project style)
    "@typescript-eslint/explicit-function-return-type": "off",
    "@typescript-eslint/explicit-module-boundary-types": "off",
    "@typescript-eslint/no-non-null-assertion": "off",
    "no-case-declarations": "off",
    "no-constant-condition": "off",
    "no-param-reassign": "off",
    "no-plusplus": "off",
    // mc-sim's tsconfig.base.json deliberately types absence structurally
    // (`noUncheckedIndexedAccess`, `exactOptionalPropertyTypes`): `X | undefined`
    // is the codebase's normal way of expressing "no value", not a sentinel to
    // avoid. Banning the literal `undefined` token fights that convention.
    // Matches @nerima-games/mc-kernel's `.oxlintrc.json` (same disable, same
    // category-default-only origin — not from this file's explicit `rules`).
    "no-undefined": "off",
    // Conflicts with this file's own `@typescript-eslint/no-floating-promises:
    // warn` above: `void somePromise.then(...)` is the standard, explicit way
    // to mark a promise as an intentional fire-and-forget, and apps/preview-sim
    // (a terminal UI driven by callbacks) relies on it.
    "no-void": "off"
  },
  "ignorePatterns": ["node_modules/**", "coverage/**", "dist/**", ".git/**", "*.config.ts", "docs/**"]
}
