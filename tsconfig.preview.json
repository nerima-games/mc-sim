{
  // The dev preview under apps/preview-sim.
  //
  // A SEPARATE project on purpose. tsconfig.build.json proves that the shipped
  // simulation is platform-free — it inherits `types: []` and a `lib` without
  // "DOM", so a Node global or a browser type leaking into `domain/` or
  // `application/` fails the build. That proof is what plan.md §3.8 rests on
  // when it asks for headless deterministic scenario tests, and it would be
  // destroyed by adding `apps/**` to that project's `include`.
  //
  // NOTE what this file does NOT do: it does not add "DOM" to `lib`. The preview
  // renders to a terminal, so it needs Node's stdio and nothing from a browser.
  // If a future preview ever needs "DOM" here — the first-person obstacle course
  // docs/testing.md describes will — that is the moment to ask whether it still
  // belongs in this repository at all. See apps/preview-sim/main.ts.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "types": ["node"]
  },
  "include": ["apps/**/*.ts", "index.ts", "domain/**/*.ts", "application/**/*.ts", "stages/**/*.ts"],
  "exclude": ["node_modules", "coverage", "dist"]
}
